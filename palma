  <div class="menu-category">

    <h3>Pizzas</h3>

    <div class="menu-item"><span>Margherita</span><span>$10</span></div>

    <div class="menu-item"><span>Pepperoni</span><span>$11</span></div>

    <div class="menu-item"><span>Seafood Pizza</span><span>$13</span></div>

  </div>

  <div class="menu-category">

    <h3>Pastas</h3>

    <div class="menu-item"><span>Spaghetti Carbonara</span><span>$12</span></div>

    <div class="menu-item"><span>Penne Arrabbiata</span><span>$11</span></div>

    <div class="menu-item"><span>Lasagna</span><span>$13</span></div>

  </div>

  <div class="menu-category">

    <h3>Desserts</h3>

    <div class="menu-item"><span>Tiramisu</span><span>$6</span></div>

    <div class="menu-item"><span>Baklava</span><span>$5</span></div>

    <div class="menu-item"><span>Gelato</span><span>$4</span></div>

  </div>

  <div class="menu-category">

    <h3>Beverages</h3>

    <div class="menu-item"><span>Fresh Juices</span><span>$3</span></div>

    <div class="menu-item"><span>Soft Drinks</span><span>$2</span></div>

    <div class="menu-item"><span>Coffee & Tea</span><span>$3</span></div>

  </div>

</section>

<section id="gallery">

  <h2>Gallery</h2>

  <div class="gallery">

    <img src="https://via.placeholder.com/300x200" alt="Dish 1">

    <img src="https://via.placeholder.com/300x200" alt="Dish 2">

    <img src="https://via.placeholder.com/300x200" alt="Restaurant Interior">

  </div>

</section>

<section id="reservation">

  <h2>Reserve a Table</h2>

  <form>

    <input type="text" placeholder="Your Name" required>

    <input type="email" placeholder="Your Email" required>

    <input type="tel" placeholder="Phone Number" required>

    <input type="date" required>

    <input type="time" required>

    <input type="number" placeholder="Number of Guests" min="1" required>

    <textarea placeholder="Special Requests"></textarea>

    <button type="submit">Reserve Now</button>

  </form>

</section>

<section id="contact">

  <h2>Contact Us</h2>

  <p>Address: Amman, Jordan</p>

  <p>Phone: +962 7 1234 5678</p>

  <p>Email: info@palma-restaurant.com</p>

  <iframe src="https://www.google.com/maps/embed?pb=!1m18..." width="100%" height="300" style="border:0;" allowfullscreen="" loading="lazy"></iframe>

</section>

<footer>

  <p>Follow us: 

    <a href="#">Instagram</a> | 

    <a href="#">Facebook</a>

  </p>

  <p>Open Daily: 11:00 AM - 11:00 PM</p>

  <p>&copy; 2026 Palma Restaurant</p>

</footer>

</body>

</html>
