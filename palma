<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Palma Restaurant - Amman, Jordan</title>

  <style>

    body {

      font-family: Arial, sans-serif;

      margin: 0;

      padding: 0;

      background-color: #fff8f0;

      color: #333;

    }

    header {

      background-color: #c0392b;

      color: white;

      padding: 20px;

      text-align: center;

    }

    header h1 {

      margin: 0;

      font-size: 2.5em;

    }

    nav {

      background-color: #e74c3c;

      display: flex;

      justify-content: center;

      padding: 10px 0;

    }

    nav a {

      color: white;

      text-decoration: none;

      margin: 0 15px;

      font-weight: bold;

    }

    nav a:hover {

      text-decoration: underline;

    }

    section {

      padding: 40px 20px;

      max-width: 1000px;

      margin: auto;

    }

    h2 {

      color: #c0392b;

      text-align: center;

      margin-bottom: 20px;

    }

    .menu-category {

      margin-bottom: 30px;

    }

    .menu-item {

      display: flex;

      justify-content: space-between;

      padding: 5px 0;

      border-bottom: 1px solid #ddd;

    }

    .menu-item:last-child {

      border-bottom: none;

    }

    .gallery img {

      width: 30%;

      margin: 1.66%;

      border-radius: 8px;

    }

    form {

      display: flex;

      flex-direction: column;

      max-width: 500px;

      margin: auto;

    }

    form input, form select, form textarea, form button {

      padding: 10px;

      margin: 5px 0;

      font-size: 1em;

    }

    form button {

      background-color: #c0392b;

      color: white;

      border: none;

      cursor: pointer;

    }

    form button:hover {

      background-color: #e74c3c;

    }

    footer {

      background-color: #c0392b;

      color: white;

      text-align: center;

      padding: 20px;

      margin-top: 40px;

    }

    footer a {

      color: white;

      margin: 0 5px;

      text-decoration: none;

    }

    footer a:hover {

      text-decoration: underline;

    }

    @media (max-width: 768px) {

      .gallery img {

        width: 48%;

        margin: 1%;

      }

    }

    @media (max-width: 480px) {

      .gallery img {

        width: 100%;

        margin: 0 0 10px 0;

      }

    }

  </style>

</head>

<body>

<header>

  <h1>Palma Restaurant</h1>

  <p>Authentic Mediterranean & Italian Cuisine in Amman, Jordan</p>

</header>

<nav>

  <a href="#about">About Us</a>

  <a href="#menu">Menu</a>

  <a href="#gallery">Gallery</a>

  <a href="#reservation">Reservation</a>

  <a href="#contact">Contact</a>

</nav>

<section id="about">

  <h2>About Us</h2>

  <p>Welcome to Palma Restaurant! We serve authentic Mediterranean and Italian dishes made from the freshest ingredients. Our goal is to provide a warm, family-friendly dining experience where every guest feels at home.</p>

</section>

<section id="menu">

