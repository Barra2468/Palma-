  <div class="menu-category">

    <h3>Appetizers</h3>

    <div class="menu-item"><span>Hummus</span><span>$5</span></div>

    <div class="menu-item"><span>Stuffed Grape Leaves</span><span>$6</span></div>

    <div class="menu-item"><span>Garlic Bread</span><span>$4</span></div>

  </div>

  <div class="menu-category">

    <h3>Salads</h3>

